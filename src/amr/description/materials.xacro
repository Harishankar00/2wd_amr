<?xml version="1.0"?>
<!--
  materials.xacro
  Defines URDF visual materials and Gazebo material macros for the 2WD AMR.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="materials">

  <!-- ═══════════════════════════════════════════
       URDF visual materials (RViz colours)
       ═══════════════════════════════════════════ -->
  <material name="black">
    <color rgba="0.0 0.0 0.0 1.0"/>
  </material>

  <material name="dark_grey">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>

  <material name="grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <material name="light_grey">
    <color rgba="0.75 0.75 0.75 1.0"/>
  </material>

  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>

  <material name="orange">
    <color rgba="1.0 0.45 0.0 1.0"/>
  </material>

  <material name="blue">
    <color rgba="0.0 0.3 0.8 1.0"/>
  </material>

  <material name="yellow">
    <color rgba="1.0 0.85 0.0 1.0"/>
  </material>

  <!-- ═══════════════════════════════════════════
       Gazebo material macros (PBR-style)
       Usage: <xacro:gz_material_X link="link_name"/>
       ═══════════════════════════════════════════ -->

  <!-- Chassis body — dark grey -->
  <xacro:macro name="gz_material_chassis" params="link">
    <gazebo reference="${link}">
      <material>
        <ambient>0.18 0.18 0.18 1.0</ambient>
        <diffuse>0.18 0.18 0.18 1.0</diffuse>
        <specular>0.05 0.05 0.05 1.0</specular>
        <emissive>0.0 0.0 0.0 1.0</emissive>
      </material>
    </gazebo>
  </xacro:macro>

  <!-- Drive wheels — black rubber -->
  <xacro:macro name="gz_material_wheel" params="link">
    <gazebo reference="${link}">
      <material>
        <ambient>0.05 0.05 0.05 1.0</ambient>
        <diffuse>0.05 0.05 0.05 1.0</diffuse>
        <specular>0.02 0.02 0.02 1.0</specular>
        <emissive>0.0 0.0 0.0 1.0</emissive>
      </material>
    </gazebo>
  </xacro:macro>

  <!-- Caster spheres — light grey -->
  <xacro:macro name="gz_material_caster" params="link">
    <gazebo reference="${link}">
      <material>
        <ambient>0.7 0.7 0.7 1.0</ambient>
        <diffuse>0.7 0.7 0.7 1.0</diffuse>
        <specular>0.2 0.2 0.2 1.0</specular>
        <emissive>0.0 0.0 0.0 1.0</emissive>
      </material>
    </gazebo>
  </xacro:macro>

  <!-- LiDAR sensor — blue accent -->
  <xacro:macro name="gz_material_lidar" params="link">
    <gazebo reference="${link}">
      <material>
        <ambient>0.0 0.3 0.8 1.0</ambient>
        <diffuse>0.0 0.3 0.8 1.0</diffuse>
        <specular>0.3 0.3 0.3 1.0</specular>
        <emissive>0.0 0.0 0.0 1.0</emissive>
      </material>
    </gazebo>
  </xacro:macro>

</robot>
